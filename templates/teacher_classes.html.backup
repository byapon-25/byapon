<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>My Classes | BYAPON</title>

<style>
body{
margin:0;
font-family:Arial,sans-serif;
background:#f5f7fb;
color:#111827
}

.top{
background:#111827;
color:white;
padding:24px
}

.top a{
float:right;
color:white;
text-decoration:none
}

.container{
max-width:1100px;
margin:auto;
padding:25px
}

.card{
background:white;
border-radius:20px;
padding:25px;
box-shadow:0 8px 28px rgba(0,0,0,.07);
margin-bottom:25px
}

input{
width:100%;
box-sizing:border-box;
padding:12px;
border:1px solid #ddd;
border-radius:9px;
margin-top:6px
}

label{
font-weight:bold;
font-size:14px
}

button,.back{
background:#111827;
color:white;
border:0;
padding:11px 18px;
border-radius:9px;
cursor:pointer;
text-decoration:none
}

table{
width:100%;
border-collapse:collapse
}

th,td{
padding:13px;
border-bottom:1px solid #eee;
text-align:left
}

.danger{
background:#dc2626
}

.grid{
display:grid;
grid-template-columns:repeat(auto-fit,minmax(200px,1fr));
gap:15px
}
</style>
</head>

<body>

<div class="top">
<a href="/logout">Logout</a>
<h2>BYAPON COACHING CENTER</h2>
</div>

<div class="container">

<a class="back" href="/dashboard">
← Dashboard
</a>


<div class="card" style="margin-top:20px">

<h2>Record Class</h2>

<form method="post">

<div class="grid">

<div>
<label>Date</label>
<input type="date" name="class_date" required>
</div>

<div>
<label>Batch</label>
<input type="text" name="batch" placeholder="e.g. HSC 2027" required>
</div>

<div>
<label>Subject</label>
<input type="text" name="subject" placeholder="e.g. Mathematics" required>
</div>

<div>
<label>Topic</label>
<input type="text" name="topic" placeholder="Today's topic" required>
</div>

</div>

<br>

<button type="submit">
+ Save Class
</button>

</form>

</div>


<div class="card">

<h2>Class History</h2>

<div style="overflow-x:auto">

<table>

<thead>

<tr>
<th>Date</th>
<th>Batch</th>
<th>Subject</th>
<th>Topic</th>
<th>Action</th>
</tr>

</thead>

<tbody>

{% for c in classes %}

<tr>

<td>{{c.class_date}}</td>

<td>{{c.batch}}</td>

<td>{{c.subject}}</td>

<td>{{c.topic}}</td>

<td>

<form method="post"
action="/teacher/classes/{{c.id}}/delete"
onsubmit="return confirm('Delete this class record?');">

<button class="danger">
Delete
</button>

</form>

</td>

</tr>

{% else %}

<tr>

<td colspan="5"
style="text-align:center;padding:35px;color:#777">

No class records yet.

</td>

</tr>

{% endfor %}

</tbody>

</table>

</div>

</div>

</div>

</body>
</html>
