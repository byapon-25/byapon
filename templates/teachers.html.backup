{% extends "base.html" %}
{% block content %}

<style>
.head{display:flex;justify-content:space-between;align-items:center;gap:15px;flex-wrap:wrap;margin-bottom:24px}
.head h2{font-weight:800;margin:0}
.box{background:white;border-radius:20px;box-shadow:0 8px 30px rgba(0,0,0,.07);overflow:hidden}
.table th{background:#f8fafc;color:#667085;font-size:12px;text-transform:uppercase}
.table td,.table th{padding:14px;vertical-align:middle}
.name{font-weight:700}
</style>

<div class="head">

<div>
<h2>Teachers</h2>
<div class="text-muted">
Manage teachers, salary and login accounts.
</div>
</div>

<button class="btn btn-dark px-4"
        data-bs-toggle="modal"
        data-bs-target="#addTeacher">
+ Add Teacher
</button>

</div>

<div class="box">

<div class="table-responsive">

<table class="table table-hover mb-0">

<thead>
<tr>
<th>Teacher ID</th>
<th>Name</th>
<th>Phone</th>
<th>Subject</th>
<th>Qualification</th>
<th>Salary</th>
<th>Status</th>
<th>Actions</th>
</tr>
</thead>

<tbody>

{% for t in teachers %}

<tr>

<td><strong>{{t.teacher_id}}</strong></td>

<td>
<div class="name">{{t.name}}</div>
</td>

<td>{{t.phone or '-'}}</td>

<td>{{t.subject or '-'}}</td>

<td>{{t.qualification or '-'}}</td>

<td>৳{{'%.2f'|format(t.salary or 0)}}</td>

<td>
{% if t.active %}
<span class="badge text-bg-success">Active</span>
{% else %}
<span class="badge text-bg-danger">Inactive</span>
{% endif %}
</td>

<td>

<div class="d-flex gap-1">

<a href="{{url_for('edit_teacher',tid=t.id)}}"
   class="btn btn-sm btn-warning">
✏️ Edit
</a>

<form method="post"
      action="{{url_for('delete_teacher',tid=t.id)}}"
      onsubmit="return confirm('Delete this teacher permanently?');">

<button class="btn btn-sm btn-outline-danger">
🗑️ Delete
</button>

</form>

</div>

</td>

</tr>

{% else %}

<tr>
<td colspan="8"
    class="text-center text-muted py-5">
No teachers added yet.
</td>
</tr>

{% endfor %}

</tbody>
</table>

</div>
</div>


<!-- ADD TEACHER -->

<div class="modal fade" id="addTeacher">

<div class="modal-dialog modal-dialog-centered">

<div class="modal-content">

<form method="post">

<div class="modal-header bg-dark text-white">

<h5 class="modal-title">
Add New Teacher
</h5>

<button type="button"
        class="btn-close btn-close-white"
        data-bs-dismiss="modal"></button>

</div>

<div class="modal-body p-4">

<div class="mb-3">
<label class="form-label">Teacher ID</label>
<input class="form-control"
       name="teacher_id"
       placeholder="e.g. T-1001"
       required>
</div>

<div class="mb-3">
<label class="form-label">Full Name</label>
<input class="form-control"
       name="name"
       required>
</div>

<div class="row">

<div class="col-md-6 mb-3">
<label class="form-label">Phone</label>
<input class="form-control" name="phone">
</div>

<div class="col-md-6 mb-3">
<label class="form-label">Subject</label>
<input class="form-control"
       name="subject"
       placeholder="Mathematics">
</div>

</div>

<div class="mb-3">
<label class="form-label">Qualification</label>
<input class="form-control"
       name="qualification"
       placeholder="B.Sc / M.Sc / B.Ed">
</div>

<div class="mb-3">
<label class="form-label">Monthly Salary</label>
<input class="number"
       type="number"
       step="0.01"
       class="form-control"
       name="salary"
       value="0">
</div>

<div class="mb-3">
<label class="form-label">Login Password</label>
<input type="password"
       class="form-control"
       name="password"
       required>
</div>

</div>

<div class="modal-footer">

<button type="button"
        class="btn btn-outline-secondary"
        data-bs-dismiss="modal">
Cancel
</button>

<button class="btn btn-dark px-4">
Create Teacher
</button>

</div>

</form>

</div>
</div>
</div>

{% endblock %}
